{
  "Jwt": {
    // NO SigningKey here on purpose — it lives in user-secrets (dev) or
    // env var Jwt__SigningKey (prod). Startup fails loudly without it.
    "Issuer": "jajewelry-api",
    "Audience": "jajewelry-app",
    "ExpireMinutes": 720
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/jewerly-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600,
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "LogRetention": {
    "WarnDays": 30,
    "ErrorDays": 90
  },
  "ConnectionStrings": {
    "myDBConn": "Server=isetech.com.mx;Database=isetechc_jewelry_inventory;User=isetechc_jewerly;Password=jewerlyRoot;"
  },
  "AllowedHosts": "*"
}
